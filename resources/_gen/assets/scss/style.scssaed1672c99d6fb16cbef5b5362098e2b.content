@import url("https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap");
* {
  box-sizing: border-box; }

html {
  scroll-behavior: smooth; }

body {
  margin: 0;
  background: #0F0E1A;
  color: #EDEBFA;
  font-family: "Manrope", sans-serif;
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased; }

a {
  color: inherit;
  text-decoration: none; }

.container {
  width: calc(100% - 64px);
  max-width: 1180px;
  margin: 0 auto; }

.header {
  position: absolute;
  z-index: 10;
  width: 100%;
  padding: 26px 0;
  border-bottom: 1px solid rgba(245, 247, 242, 0.12); }

.header.sticky {
  position: fixed;
  background: rgba(15, 14, 26, 0.92);
  backdrop-filter: blur(14px);
  padding: 17px 0; }

.header-inner {
  display: flex;
  align-items: center;
  gap: 32px; }

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0; }

.brand-mark {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  border: 1px solid #8B5CF6;
  color: #8B5CF6;
  border-radius: 50%;
  font-size: 17px;
  font-weight: 800; }

.brand-name {
  font-weight: 800;
  letter-spacing: -.05em;
  font-size: 17px;
  line-height: .9; }

.brand-name span {
  display: block;
  font-size: 8px;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: #9C97B8;
  margin-top: 4px;
  font-weight: 500; }

.main-menu {
  margin-left: auto; }

.main-menu ul {
  display: flex;
  gap: 28px;
  padding: 0;
  margin: 0;
  list-style: none; }

.main-menu a, .header-cta {
  font: 500 11px "DM Mono", monospace;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: #9C97B8;
  transition: color .2s ease; }

.main-menu a:hover, .main-menu .active a {
  color: #EDEBFA; }

.header-cta {
  color: #0F0E1A;
  background: #8B5CF6;
  padding: 11px 15px;
  border-radius: 2px; }

.header-cta span, .button span, .text-link span, .card-link span {
  margin-left: 10px;
  font-size: 15px; }

.hamburger, .main-menu-mobile {
  display: none; }

.hero-section {
  min-height: 800px;
  padding: 190px 0 115px;
  overflow: hidden;
  border-bottom: 1px solid #302B4C; }

.hero-grid {
  display: grid;
  grid-template-columns: .92fr 1.08fr;
  align-items: center;
  gap: 50px; }

.eyebrow {
  color: #8B5CF6;
  margin: 0 0 26px;
  font: 500 10px "DM Mono", monospace;
  letter-spacing: .13em;
  text-transform: uppercase; }

.status-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  background: #8B5CF6;
  border-radius: 50%;
  margin-right: 9px;
  box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.14); }

h1, h2, h3, p {
  margin-top: 0; }

h1 {
  font-size: clamp(3.4rem, 6.5vw, 6.7rem);
  letter-spacing: -.09em;
  line-height: .91;
  margin-bottom: 34px;
  font-weight: 700; }

h1 span, h2 span {
  color: #8B5CF6; }

.hero-lede {
  max-width: 405px;
  color: #9C97B8;
  font-size: 17px;
  line-height: 1.6;
  margin-bottom: 35px; }

.hero-actions {
  display: flex;
  gap: 25px;
  align-items: center; }

.button {
  display: inline-flex;
  align-items: center;
  padding: 16px 20px;
  font: 500 11px "DM Mono", monospace;
  text-transform: uppercase;
  letter-spacing: .08em;
  transition: transform .2s ease; }

.button:hover {
  transform: translateY(-2px); }

.button-primary {
  background: #8B5CF6;
  color: #0F0E1A; }

.text-link {
  color: #EDEBFA;
  font: 500 11px "DM Mono", monospace;
  text-transform: uppercase;
  letter-spacing: .08em;
  border-bottom: 1px solid rgba(245, 247, 242, 0.4);
  padding-bottom: 5px; }

.hero-meta {
  display: flex;
  gap: 13px;
  align-items: center;
  margin-top: 85px;
  font: 10px "DM Mono", monospace;
  color: #9C97B8;
  text-transform: uppercase;
  letter-spacing: .05em; }

.meta-line {
  height: 1px;
  width: 30px;
  background: #302B4C; }

.hero-visual {
  min-height: 470px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center; }

.orb {
  position: absolute;
  border-radius: 50%; }

.orb-one {
  width: 440px;
  height: 440px;
  background: radial-gradient(circle at 30% 30%, rgba(139, 92, 246, 0.25), transparent 65%);
  right: -40px;
  top: -40px; }

.orb-two {
  width: 250px;
  height: 250px;
  background: rgba(56, 189, 248, 0.14);
  filter: blur(45px);
  left: 10px;
  bottom: 5px; }

.product-window {
  width: 100%;
  max-width: 540px;
  position: relative;
  z-index: 1;
  background: #17152a;
  border: 1px solid #403765;
  border-radius: 8px;
  box-shadow: 20px 30px 80px rgba(0, 0, 0, 0.38);
  transform: rotate(2deg); }

.window-topbar {
  height: 40px;
  padding: 0 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #211d3c;
  border-bottom: 1px solid #403765;
  color: #9C97B8;
  font: 10px "DM Mono", monospace; }

.window-dots {
  display: flex;
  gap: 5px; }

.window-dots i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #675e88; }

.window-dots i:first-child {
  background: #38BDF8; }

.window-label {
  letter-spacing: .04em; }

.window-menu {
  letter-spacing: 3px; }

.window-body {
  display: flex;
  min-height: 365px; }

.window-sidebar {
  width: 54px;
  padding: 17px 0;
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 21px;
  border-right: 1px solid #332d50; }

.side-mark {
  color: #8B5CF6;
  font-size: 16px;
  font-weight: 800;
  margin-bottom: 8px; }

.side-icon {
  width: 13px;
  height: 13px;
  border: 1px solid #746b9b;
  border-radius: 3px;
  opacity: .65; }

.side-icon.active {
  background: #8B5CF6;
  border-color: #8B5CF6; }

.side-bottom {
  margin-top: auto;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: #746b9b; }

.dashboard {
  flex: 1;
  padding: 28px; }

.dashboard-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25px; }

.mini-label, .metric-card span {
  display: block;
  font: 9px "DM Mono", monospace;
  color: #9C97B8;
  letter-spacing: .1em;
  margin-bottom: 7px; }

.dashboard-heading strong {
  font-size: 17px;
  font-weight: 600;
  letter-spacing: -.04em; }

.avatar, .tag-avatar {
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #c5b8f7;
  color: #30225e;
  width: 27px;
  height: 27px;
  font: 9px "DM Mono", monospace; }

.metric-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 11px;
  margin-bottom: 12px; }

.metric-card {
  background: #211d3c;
  padding: 15px;
  border-radius: 3px; }

.metric-card strong {
  display: block;
  font-size: 24px;
  letter-spacing: -.06em;
  margin-bottom: 5px; }

.metric-card small {
  color: #8B5CF6;
  font: 9px "DM Mono", monospace; }

.metric-card em {
  font-style: normal;
  font-size: 13px; }

.chart-card {
  background: #252142;
  padding: 17px 15px 12px;
  border-radius: 3px; }

.chart-header {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  margin-bottom: 16px; }

.chart-header small {
  color: #9C97B8;
  font: 9px "DM Mono", monospace; }

.chart {
  height: 125px;
  position: relative;
  border-top: 1px solid #443b68;
  border-bottom: 1px solid #443b68; }

.chart svg {
  width: 100%;
  height: 100%;
  padding-left: 24px; }

.chart-y {
  position: absolute;
  left: 0;
  color: #9C97B8;
  font: 8px "DM Mono", monospace; }

.y-one {
  top: 7px; }

.y-two {
  top: 50px; }

.y-three {
  bottom: 5px; }

.chart-labels {
  display: flex;
  justify-content: space-between;
  padding: 9px 0 0 24px;
  color: #9C97B8;
  font: 7px "DM Mono", monospace; }

.visual-tag {
  position: absolute;
  z-index: 2;
  background: #8B5CF6;
  color: #0F0E1A;
  box-shadow: 12px 12px 35px rgba(0, 0, 0, 0.2); }

.tag-top {
  right: 0;
  top: 19px;
  padding: 11px 14px;
  font-size: 20px;
  font-weight: 700;
  transform: rotate(-5deg); }

.visual-tag small {
  display: block;
  font: 9px "DM Mono", monospace;
  margin-top: 2px; }

.tag-bottom {
  left: 7px;
  bottom: 13px;
  display: flex;
  gap: 10px;
  align-items: center;
  padding: 10px 14px 10px 10px;
  transform: rotate(-3deg); }

.tag-bottom b {
  display: block;
  font-size: 11px; }

.tag-bottom small {
  color: #4c5c26; }

.trust-strip {
  border-bottom: 1px solid #302B4C;
  padding: 25px 0; }

.trust-inner {
  display: flex;
  align-items: center;
  gap: 55px; }

.trust-inner > span {
  font: 10px "DM Mono", monospace;
  color: #9C97B8;
  letter-spacing: .1em;
  white-space: nowrap; }

.client-list {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #EDEBFA; }

.client-list b {
  font-size: 16px;
  letter-spacing: -.05em; }

.client-list b:nth-child(2) {
  color: #38BDF8; }

.client-list b:nth-child(3) {
  color: #8B5CF6; }

.client-list span {
  color: #8B5CF6;
  font-size: 8px; }

.services-section, .work-section, .principles-section {
  padding: 145px 0;
  border-bottom: 1px solid #302B4C; }

.section-heading {
  max-width: 720px; }

.section-heading h2, .principles-section h2, .contact-section h2 {
  font-size: clamp(2.8rem, 5vw, 5.1rem);
  letter-spacing: -.08em;
  line-height: .94;
  margin-bottom: 28px; }

.section-intro {
  max-width: 390px;
  color: #9C97B8;
  line-height: 1.6;
  margin-left: 37%; }

.service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin-top: 80px;
  border-top: 1px solid #302B4C;
  border-left: 1px solid #302B4C; }

.service-card {
  min-height: 380px;
  padding: 25px;
  border-right: 1px solid #302B4C;
  border-bottom: 1px solid #302B4C;
  display: flex;
  flex-direction: column; }

.service-card-featured {
  background: #8B5CF6;
  color: #0F0E1A; }

.service-number {
  font: 10px "DM Mono", monospace;
  color: #9C97B8; }

.service-card-featured .service-number {
  color: #4e6331; }

.service-icon {
  height: 105px;
  display: grid;
  place-items: center;
  font-size: 48px;
  color: #8B5CF6; }

.service-card-featured .service-icon {
  color: #0F0E1A; }

.icon-grid {
  grid-template-columns: repeat(2, 13px);
  grid-template-rows: repeat(2, 13px);
  gap: 4px; }

.icon-grid i {
  border: 1px solid #8B5CF6; }

.service-card h3 {
  font-size: 19px;
  line-height: 1.08;
  letter-spacing: -.05em;
  margin-bottom: 14px; }

.service-card p {
  color: #9C97B8;
  font-size: 13px;
  line-height: 1.55; }

.service-card-featured p {
  color: #536528; }

.card-link {
  margin-top: auto;
  font: 10px "DM Mono", monospace;
  text-transform: uppercase;
  letter-spacing: .08em; }

.work-heading {
  position: relative; }

.work-heading .text-link {
  position: absolute;
  right: 0;
  bottom: 0; }

.work-grid {
  display: grid;
  grid-template-columns: 1.3fr 1fr 1fr;
  gap: 18px;
  margin-top: 75px; }

.work-art {
  height: 355px;
  position: relative;
  overflow: hidden; }

.art-northstar {
  background: #dee8cc;
  color: #31462c; }

.art-orbit {
  width: 220px;
  height: 220px;
  position: absolute;
  left: 22%;
  top: 16%;
  border: 1px solid #738f61;
  border-radius: 50%;
  box-shadow: 0 0 0 32px rgba(115, 143, 97, 0.07), 0 0 0 65px rgba(115, 143, 97, 0.05); }

.art-word {
  position: absolute;
  top: 40%;
  left: 13%;
  font-size: 52px;
  line-height: .8;
  font-weight: 800;
  letter-spacing: -.11em; }

.art-word span {
  font-size: 10px;
  vertical-align: top; }

.art-caption {
  position: absolute;
  left: 14px;
  bottom: 13px;
  font: 10px "DM Mono", monospace;
  text-transform: uppercase;
  line-height: 1.35; }

.art-arc {
  background: #d9d7ff;
  color: #443f89; }

.arc-label {
  position: absolute;
  top: 23px;
  left: 23px;
  font-size: 30px;
  font-weight: 800;
  letter-spacing: -.1em; }

.arc-label span {
  color: #ef6f62; }

.arc-shape {
  position: absolute;
  width: 210px;
  height: 210px;
  border: 45px solid #8075db;
  border-radius: 50%;
  right: -60px;
  bottom: -40px; }

.arc-caption, .pivot-caption {
  position: absolute;
  left: 23px;
  bottom: 22px;
  font-size: 23px;
  line-height: .95;
  letter-spacing: -.08em;
  font-weight: 700; }

.art-pivot {
  background: #ff9a68;
  color: #3e2319; }

.pivot-mark {
  position: absolute;
  top: 22px;
  left: 23px;
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -.09em; }

.pivot-mark span {
  font-size: 15px; }

.pivot-line {
  position: absolute;
  width: 160%;
  height: 1px;
  background: #5d3828;
  transform: rotate(-37deg);
  top: 40%;
  left: -30%; }

.pivot-caption {
  font-size: 22px; }

.work-info {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16px 2px 0; }

.work-info span {
  display: block;
  font-size: 14px;
  font-weight: 600; }

.work-info small {
  display: block;
  color: #9C97B8;
  font: 10px "DM Mono", monospace;
  margin-top: 6px; }

.work-arrow {
  color: #8B5CF6;
  font-size: 22px !important; }

.principles-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 100px; }

.principles-list > div {
  display: grid;
  grid-template-columns: 40px 1fr;
  column-gap: 18px;
  padding: 22px 0;
  border-top: 1px solid #302B4C; }

.principles-list > div:last-child {
  border-bottom: 1px solid #302B4C; }

.principles-list span {
  color: #8B5CF6;
  font: 11px "DM Mono", monospace; }

.principles-list h3 {
  margin: 0 0 7px;
  font-size: 19px;
  letter-spacing: -.04em; }

.principles-list p {
  grid-column: 2;
  margin: 0;
  color: #9C97B8;
  font-size: 13px;
  max-width: 330px; }

.flagship-case {
  display: grid;
  grid-template-columns: .9fr 1.1fr;
  gap: 70px;
  margin-top: 70px;
  padding: 22px;
  background: #1A1830;
  border: 1px solid #302B4C; }

.case-visual {
  min-height: 430px;
  position: relative;
  overflow: hidden;
  background: radial-gradient(circle at 68% 25%, rgba(139, 92, 246, 0.55), transparent 27%), linear-gradient(140deg, #201a3e, #111022 70%); }

.case-orbit {
  position: absolute;
  width: 330px;
  height: 330px;
  top: 48px;
  left: 50%;
  border: 1px solid rgba(56, 189, 248, 0.62);
  border-radius: 50%;
  transform: translateX(-50%);
  box-shadow: 0 0 0 32px rgba(139, 92, 246, 0.08), 0 0 0 72px rgba(56, 189, 248, 0.05); }

.case-label {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 1;
  color: #EDEBFA;
  font-size: 64px;
  line-height: .8;
  letter-spacing: -.11em;
  font-weight: 800;
  transform: translate(-50%, -50%); }

.case-label span {
  display: block;
  margin-top: 15px;
  color: #38BDF8;
  font: 10px "DM Mono", monospace;
  letter-spacing: .13em;
  text-align: center; }

.case-pills {
  position: absolute;
  left: 18px;
  bottom: 18px;
  display: flex;
  gap: 7px;
  flex-wrap: wrap; }

.case-pills span {
  padding: 7px 9px;
  border: 1px solid rgba(237, 235, 250, 0.25);
  color: #EDEBFA;
  font: 9px "DM Mono", monospace;
  text-transform: uppercase; }

.case-copy {
  padding: 22px 10px 15px 0; }

.case-kicker {
  color: #38BDF8;
  font: 10px "DM Mono", monospace;
  letter-spacing: .08em;
  text-transform: uppercase; }

.case-copy h3 {
  max-width: 490px;
  margin: 25px 0 20px;
  font-size: clamp(2rem, 3.5vw, 3.6rem);
  line-height: .97;
  letter-spacing: -.08em; }

.case-copy > p:not(.case-kicker) {
  max-width: 530px;
  color: #9C97B8;
  font-size: 14px;
  line-height: 1.7; }

.case-details {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-top: 35px;
  padding-top: 22px;
  border-top: 1px solid #302B4C; }

.case-details div {
  display: flex;
  flex-direction: column;
  gap: 6px; }

.case-details span {
  color: #8B5CF6;
  font: 10px "DM Mono", monospace; }

.case-details b {
  font-size: 13px;
  line-height: 1.1; }

.case-details small {
  color: #9C97B8;
  font-size: 10px;
  line-height: 1.3; }

.secondary-work {
  margin-top: 85px; }

.secondary-work > .eyebrow {
  color: #9C97B8; }

.secondary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px; }

.secondary-grid article {
  padding: 25px;
  border: 1px solid #302B4C;
  background: rgba(26, 24, 48, 0.45); }

.secondary-icon {
  display: grid;
  place-items: center;
  width: 39px;
  height: 39px;
  margin-bottom: 32px;
  border: 1px solid #8B5CF6;
  color: #8B5CF6;
  font-size: 18px; }

.secondary-grid h3 {
  margin-bottom: 10px;
  font-size: 19px;
  letter-spacing: -.05em; }

.secondary-grid p {
  min-height: 62px;
  margin-bottom: 22px;
  color: #9C97B8;
  font-size: 13px;
  line-height: 1.55; }

.secondary-grid span {
  color: #EDEBFA;
  font: 10px "DM Mono", monospace;
  text-transform: uppercase;
  letter-spacing: .06em; }

.contact-section {
  background: #8B5CF6;
  color: #EDEBFA;
  text-align: center;
  padding: 150px 0 110px; }

.contact-section .eyebrow {
  color: #d7c8ff; }

.contact-section h2 span {
  color: #EDEBFA;
  text-decoration: underline;
  text-decoration-thickness: 2px;
  text-underline-offset: 7px; }

.contact-section > .container > p:not(.eyebrow) {
  max-width: 390px;
  margin: 0 auto 35px;
  color: #eee9ff; }

.contact-section .button {
  background: #EDEBFA;
  color: #0F0E1A; }

.contact-details {
  display: flex;
  justify-content: center;
  gap: 27px;
  margin-top: 70px;
  color: #e0d5ff;
  font: 10px "DM Mono", monospace;
  text-transform: uppercase;
  letter-spacing: .06em; }

.footer {
  background: #0F0E1A;
  padding: 50px 0; }

.footer-inner {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  align-items: start; }

.footer-note {
  color: #9C97B8;
  font-size: 14px;
  line-height: 1.4; }

.footer-links {
  justify-self: end;
  display: flex;
  gap: 23px;
  font: 10px "DM Mono", monospace;
  text-transform: uppercase;
  color: #9C97B8; }

.footer-links a:hover {
  color: #8B5CF6; }

.sub-footer {
  border-top: 1px solid #302B4C;
  background: #0F0E1A;
  color: #9C97B8;
  padding: 18px 0; }

.sub-footer-inner {
  display: flex;
  justify-content: space-between;
  font: 9px "DM Mono", monospace;
  text-transform: uppercase;
  letter-spacing: .05em; }

@media (max-width: 900px) {
  .hero-grid {
    grid-template-columns: 1fr; }
  .hero-section {
    padding-top: 150px; }
  .hero-visual {
    margin-top: 20px; }
  .service-grid {
    grid-template-columns: repeat(2, 1fr); }
  .work-grid {
    grid-template-columns: 1fr 1fr; }
  .work-card-large {
    grid-column: span 2; }
  .principles-grid {
    gap: 50px; }
  .client-list {
    gap: 20px; }
  .client-list b {
    font-size: 14px; }
  .flagship-case {
    grid-template-columns: 1fr;
    gap: 35px; }
  .case-copy {
    padding: 0 10px 15px; } }

@media (max-width: 700px) {
  .container {
    width: calc(100% - 38px);
    max-width: 560px; }
  .header {
    padding: 18px 0; }
  .header-inner {
    gap: 12px; }
  .main-menu, .header-cta {
    display: none; }
  .hamburger {
    display: block;
    margin-left: auto;
    padding: 5px;
    background: none;
    border: 0; }
  .hamburger-inner, .hamburger-inner:before, .hamburger-inner:after {
    background: #EDEBFA; }
  .main-menu-mobile {
    display: block;
    position: fixed;
    z-index: 9;
    inset: 0;
    padding: 105px 20px 20px;
    background: #0F0E1A;
    transform: translateX(100%);
    transition: transform .25s ease; }
  .main-menu-mobile.open {
    transform: translateX(0); }
  .main-menu-mobile ul {
    list-style: none;
    padding: 0;
    margin: 0; }
  .main-menu-mobile li {
    border-bottom: 1px solid #302B4C; }
  .main-menu-mobile a {
    display: block;
    padding: 20px 0;
    font-size: 27px;
    letter-spacing: -.05em; }
  .hero-section {
    min-height: 0;
    padding: 130px 0 75px; }
  .hero-lede {
    font-size: 15px; }
  .hero-meta {
    margin-top: 55px;
    flex-wrap: wrap; }
  .hero-visual {
    min-height: 330px;
    margin-left: -10px;
    margin-right: -10px; }
  .product-window {
    transform: rotate(1deg) scale(0.9); }
  .tag-top {
    right: -3px;
    top: 0; }
  .tag-bottom {
    left: 0;
    bottom: 0; }
  .trust-inner {
    display: block; }
  .trust-inner > span {
    display: block;
    margin-bottom: 22px; }
  .client-list {
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 15px 26px; }
  .services-section, .work-section, .principles-section {
    padding: 90px 0; }
  .section-intro {
    margin-left: 0; }
  .service-grid {
    grid-template-columns: 1fr;
    margin-top: 50px; }
  .service-card {
    min-height: 300px; }
  .work-heading .text-link {
    position: static;
    display: inline-block; }
  .work-grid {
    grid-template-columns: 1fr;
    margin-top: 45px; }
  .work-card-large {
    grid-column: auto; }
  .work-art {
    height: 300px; }
  .principles-grid {
    grid-template-columns: 1fr;
    gap: 50px; }
  .flagship-case {
    margin-top: 45px;
    padding: 12px; }
  .case-visual {
    min-height: 300px; }
  .case-orbit {
    width: 245px;
    height: 245px;
    top: 30px; }
  .case-label {
    font-size: 48px; }
  .case-details, .secondary-grid {
    grid-template-columns: 1fr; }
  .secondary-work {
    margin-top: 60px; }
  .secondary-grid p {
    min-height: 0; }
  .contact-section {
    padding: 95px 0 70px; }
  .contact-details, .sub-footer-inner {
    flex-direction: column;
    gap: 9px; }
  .footer-inner {
    grid-template-columns: 1fr;
    gap: 27px; }
  .footer-links {
    justify-self: start;
    flex-wrap: wrap; } }

/*# sourceMappingURL=style.css.map */